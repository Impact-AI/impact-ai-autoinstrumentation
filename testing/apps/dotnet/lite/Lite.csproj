<!-- A support assistant with Microsoft.Extensions.AI's abstractions and a provider's package only, no
     Microsoft.Extensions.AI (lite/Program.cs). Restored, as Chat.csproj, from the Dockerfile's folder of pinned packages. -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <DotnetVersion Condition="'$(DotnetVersion)' == ''">10.0</DotnetVersion>
    <TargetFramework>net$(DotnetVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="[10.11.0]" />
    <PackageReference Include="OpenAI" Version="[2.15.0]" />
  </ItemGroup>
</Project>
