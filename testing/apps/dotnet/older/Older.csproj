<!-- An ASP.NET Core workload on a .NET the kit is not proved on (DotnetVersion, 8.0 by default), with no packages: the
     SDK of that .NET has everything it needs. -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <DotnetVersion Condition="'$(DotnetVersion)' == ''">8.0</DotnetVersion>
    <TargetFramework>net$(DotnetVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
